const SHEET_NAME = "Turnos";
const EXPECTED_HEADERS = [
  "Timestamp",
  "Nombre y apellido",
  "DNI",
  "Teléfono",
  "Especialidad",
  "Profesional",
  "Fecha",
  "Horario",
  "Estado",
];

function doGet(e) {
  try {
    // 1. Si existe un archivo index creado manualmente, lo usa
    const out = HtmlService.createHtmlOutputFromFile("index");
    out.setTitle("UMSA - Centro Médico Integral");
    out.addMetaTag("viewport", "width=device-width, initial-scale=1.0");
    return out;
  } catch (err) {}

  // 2. De lo contrario, sirve directamente la página web integrada
  const htmlContent = Utilities.newBlob(Utilities.base64Decode(HTML_BASE64), "text/html").getDataAsString();
  const out = HtmlService.createHtmlOutput(htmlContent);
  out.setTitle("UMSA - Centro Médico Integral");
  out.addMetaTag("viewport", "width=device-width, initial-scale=1.0");
  return out;
}

function apiCreateAppointment(payload) {
  try {
    const sheet = getOrCreateSheet();
    const appointment = {
      nombre: clean(payload.nombre),
      dni: clean(payload.dni),
      telefono: clean(payload.telefono),
      especialidad: clean(payload.especialidad),
      profesional: clean(payload.profesional),
      fecha: clean(payload.fecha),
      horario: clean(payload.horario),
      estado: "Solicitud recibida",
    };

    sheet.appendRow([
      new Date(),
      appointment.nombre,
      appointment.dni,
      appointment.telefono,
      appointment.especialidad,
      appointment.profesional,
      appointment.fecha,
      appointment.horario,
      appointment.estado,
    ]);

    return { ok: true, appointment: appointment };
  } catch (error) {
    return { ok: false, message: error.message || "No se pudo guardar el turno." };
  }
}

function apiLookupAppointment(dni) {
  try {
    const sheet = getOrCreateSheet();
    const values = sheet.getDataRange().getDisplayValues();
    const dniColumn = EXPECTED_HEADERS.indexOf("DNI");
    let foundRow = null;
    const cleanedDni = String(dni || "").replace(/\D/g, "");

    for (let rowIndex = values.length - 1; rowIndex >= 1; rowIndex -= 1) {
      const rowDni = String(values[rowIndex][dniColumn] || "").replace(/\D/g, "");
      if (rowDni === cleanedDni) {
        foundRow = values[rowIndex];
        break;
      }
    }

    if (!foundRow) {
      return { ok: true, found: false };
    }

    return {
      ok: true,
      found: true,
      appointment: {
        nombre: foundRow[1],
        dni: foundRow[2],
        telefono: foundRow[3],
        especialidad: foundRow[4],
        profesional: foundRow[5],
        fecha: normalizeDate(foundRow[6]),
        horario: foundRow[7],
        estado: foundRow[8] || "Solicitud recibida",
      },
    };
  } catch (error) {
    return { ok: false, message: error.message || "No se pudo realizar la búsqueda." };
  }
}

function getOrCreateSheet() {
  let ss = null;
  try {
    ss = SpreadsheetApp.getActiveSpreadsheet();
  } catch (e) {
    ss = null;
  }

  if (!ss) {
    throw new Error("No se encontró una planilla activa. Abrí Apps Script desde tu Google Sheet en 'Extensiones' > 'Apps Script'.");
  }

  let sheet = ss.getSheetByName(SHEET_NAME);
  if (!sheet) {
    const allSheets = ss.getSheets();
    if (allSheets.length === 1 && allSheets[0].getLastRow() === 0) {
      sheet = allSheets[0];
      sheet.setName(SHEET_NAME);
    } else {
      try {
        sheet = ss.insertSheet(SHEET_NAME);
      } catch (e) {
        sheet = ss.getActiveSheet();
      }
    }
  }

  if (sheet.getLastRow() === 0) {
    sheet.appendRow(EXPECTED_HEADERS);
  }

  return sheet;
}

function normalizeDate(value) {
  const dateParts = String(value).split(/[\/-]/);
  if (dateParts.length === 3 && dateParts[2].length === 4) {
    return dateParts[2] + "-" + dateParts[1].padStart(2, "0") + "-" + dateParts[0].padStart(2, "0");
  }
  return value;
}

function clean(value) {
  return String(value || "").trim();
}

const HTML_BASE64 = "";